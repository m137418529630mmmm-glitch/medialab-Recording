{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "medialab recording",
  "version": "1.1.2",
  "identifier": "com.medialab.recording",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "medialab recording",
        "width": 600,
        "height": 740,
        "minWidth": 540,
        "minHeight": 640,
        "maxWidth": 760,
        "center": true,
        "maximizable": false,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": { "bin/ffmpeg.exe": "ffmpeg.exe" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: AA23824D63FF93FF\nRWT/k/9jTYIjqmSuvzYw7gtHaaZv3GrlLvJB+yACjOOJZ1MBUzCrvLMM",
      "endpoints": [
        "https://github.com/m137418529630mmmm-glitch/medialab-Recording/releases/latest/download/latest.json"
      ]
    }
  }
}
